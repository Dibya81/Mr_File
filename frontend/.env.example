# DocumentVault Frontend — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.

# Backend API URL (for production). In development, Vite proxies /api to the backend.
# Examples:
#   - https://api.example.com      (production backend)
#   - http://localhost:8001        (local development)
# Leave empty to use the /api proxy (works when frontend is served behind a reverse proxy).
VITE_API_BASE_URL=
