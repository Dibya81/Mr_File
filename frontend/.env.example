# DocumentVault Frontend — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.

# Backend API URL. Must end with /api — all backend routes are mounted under /api.
# In development, leave empty (Vite proxies /api to localhost:8001).
# In production, point to your backend with the /api suffix included.
# Examples:
#   - https://api.example.com/api      (production)
#   - http://localhost:8001/api        (local backend, no proxy)
# Leave empty to use the Vite dev proxy (recommended for local dev).
VITE_API_BASE_URL=
