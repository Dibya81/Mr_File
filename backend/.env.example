# ============================================================
# DocumentVault - Backend environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Supabase project (https://app.supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# Use the Supabase connection string from Project Settings → Database → Connection string
# URL-encode any special characters in the password (e.g. @ → %40, ! → %21)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Authentication
JWT_SECRET=replace-with-a-random-32-char-secret-do-not-reuse
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Storage
STORAGE_BUCKET=documents
MAX_FILE_SIZE=52428800

# CORS — allowed frontend origins (auth cookies require specific origins, no wildcard)
# Supports two formats:
#   1. JSON array: ["https://app.yourdomain.com","https://yourdomain.com"]
#   2. Comma-separated: https://app.yourdomain.com,https://yourdomain.com
# Production example: https://app.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
